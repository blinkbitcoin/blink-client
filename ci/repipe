#!/bin/bash

set -e

if [[ $(which ytt) == "" ]]; then
  echo "You will need to install ytt to repipe. https://carvel.dev/ytt/"
  exit 1
fi

target="${FLY_TARGET:-ciblink}"
team=dev

repipe_tmpdir=$(mktemp -d -t repipe.XXXXXX)
trap 'rm -rf "$repipe_tmpdir"' INT TERM QUIT EXIT

# Keep vendor library paths while excluding vendir configuration documents.
ytt -f ci --file-mark 'vendir.yml:exclude=true' --file-mark 'vendir.lock.yml:exclude=true' > "$repipe_tmpdir/pipeline.yml"

echo "Updating pipeline @ ${target}"

fly -t ${target} set-pipeline --team=${team} -p blink-client -c "$repipe_tmpdir/pipeline.yml"
fly -t ${target} unpause-pipeline --team=${team} -p blink-client
